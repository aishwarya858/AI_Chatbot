# Copy this file to .env.local and fill in your key.
# Never put real keys in this file; it is committed to git.

# Google Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: main model (defaults to gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: models tried in order when the main one is busy
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
