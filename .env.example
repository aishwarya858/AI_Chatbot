# Copy this file to .env.local and fill in your key(s).
# Never put real keys in this file; it is committed to git.

# Which provider to use: "anthropic" or "gemini".
# If unset, Gemini is used when GEMINI_API_KEY is set, otherwise Claude.
AI_PROVIDER=gemini

# --- Anthropic Claude ---
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the model (defaults to claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the model (defaults to gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

